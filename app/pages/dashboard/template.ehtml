import "./style.css";
import { LiveView } from "@elements/app";
import { Badge } from "@elements/ui/badge";
import { Card, CardContent } from "@elements/ui/card";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { BarChart } from "@elements/ui/chart-bar";
import type { ChartConfig } from "@elements/ui/chart";
import { Shell, ShellUser } from "#app/shared/templates/shell";
import { Agent, Ticket } from "#app/shared/services/tickets";
import { FIRST_REPLY_HOURS, PRIORITIES, Status, duration, isOverdue } from "#app/shared/lib/sla";
import { firstReplyTimes, median, metTargetShare, openCount, solvedThisWeek } from "./stats";
import favicon from "#app/shared/assets/favicons/favicon.svg";

const OPEN_STATUSES: Status[] = ["new", "open", "pending"];

function active(tickets: LiveView<Ticket>): Ticket[] {
  return tickets.filter((t) => t.status !== "solved");
}

function maxCell(rows: Ticket[]): number {
  let max = 1;
  for (let s of OPEN_STATUSES) {
    for (let p of PRIORITIES) {
      max = Math.max(max, openCount(rows, s, p));
    }
  }

  return max;
}

/** One hue, light to dark: the share of the accent mixed into the surface. */
function cellStyle(n: number, max: number): string {
  if (n === 0) {
    return "";
  }

  let pct = Math.round(12 + (n / max) * 68);

  return `background: color-mix(in oklab, var(--accent) ${pct}%, var(--bg-elevated))`;
}

function isStrong(n: number, max: number): boolean {
  return n > 0 && 12 + (n / max) * 68 >= 45;
}

function medianLabel(times: number[]): string {
  let m = median(times);

  return m === null ? "–" : duration(m);
}

function solvedRows(tickets: LiveView<Ticket>, agents: Agent[], now: Date) {
  let rows = agents.map((a) => ({ id: a.id, name: a.name, solved: solvedThisWeek([...tickets], a.id, now) }));

  return rows.sort((a, b) => b.solved - a.solved || a.name.localeCompare(b.name));
}

const SOLVED_CHART: ChartConfig = {
  solved: { label: "Solved", color: "var(--accent)" },
};

function share(value: number | null): string {
  return value === null ? "–" : `${Math.round(value * 100)}%`;
}

<html lang="en" class="page-dashboard" (
  me: ShellUser,
  tickets: LiveView<Ticket>,
  agents: Agent[],
  private now: { value: Date } = { value: new Date() },
) oninit={() => setInterval(() => now.value = new Date(), 60_000)}>
  <head>
    <title>Dashboard · replyhaven</title>
    <meta name="description" content="How the support queue is doing.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Shell me={me} active="dashboard">
      <div class="dash stack is-lg">
        <div class="dash-head stack is-xs">
          <h1>Dashboard</h1>
          <p>Live from the queue. First reply times cover tickets opened in the last 30 days.</p>
        </div>

        <div class="tiles">
          <Card size="sm">
            <CardContent>
              <p class="tile-label">Open tickets</p>
              <p class="tile-value">{active(tickets).length}</p>
              <p class="tile-note">{active(tickets).filter((t) => !t.assigneeId).length} unassigned</p>
            </CardContent>
          </Card>
          <Card size="sm">
            <CardContent>
              <p class="tile-label">Overdue for first reply</p>
              <p class="tile-value">{tickets.filter((t) => isOverdue(t, now.value)).length}</p>
              <p class="tile-note" e:if={tickets.filter((t) => isOverdue(t, now.value)).length > 0}><Badge variant="danger" dot class="normal-case">Needs attention</Badge></p>
              <p class="tile-note" e:else>Every ticket is inside its target</p>
            </CardContent>
          </Card>
          <Card size="sm">
            <CardContent>
              <p class="tile-label">Median first reply</p>
              <p class="tile-value">{medianLabel(firstReplyTimes([...tickets], now.value))}</p>
              <p class="tile-note">across {firstReplyTimes([...tickets], now.value).length} replied tickets</p>
            </CardContent>
          </Card>
          <Card size="sm">
            <CardContent>
              <p class="tile-label">Solved this week</p>
              <p class="tile-value">{solvedRows(tickets, agents, now.value).reduce((sum, r) => sum + r.solved, 0)}</p>
              <p class="tile-note">since Monday</p>
            </CardContent>
          </Card>
        </div>

        <div class="dash-grid">
          <Card title="Open tickets by status and priority" description="Darker cells hold more tickets." level={2}>
            <CardContent>
              <table class="heat">
                <thead>
                  <tr>
                    <th><span class="sr-only">Status</span></th>
                    <th e:for={p of PRIORITIES} scope="col">{p}</th>
                    <th scope="col">Total</th>
                  </tr>
                </thead>
                <tbody>
                  <tr e:for={s of OPEN_STATUSES}>
                    <th scope="row">{s}</th>
                    <td e:for={p of PRIORITIES}
                        class={["cell", openCount(active(tickets), s, p) === 0 && "is-zero", isStrong(openCount(active(tickets), s, p), maxCell(active(tickets))) && "is-strong"]}
                        style={cellStyle(openCount(active(tickets), s, p), maxCell(active(tickets)))}
                        title={`${openCount(active(tickets), s, p)} ${s}, ${p} priority`}>
                      {openCount(active(tickets), s, p)}
                    </td>
                    <td class="total">{active(tickets).filter((t) => t.status === s).length}</td>
                  </tr>
                  <tr>
                    <th scope="row">Total</th>
                    <td e:for={p of PRIORITIES} class="total">{active(tickets).filter((t) => t.priority === p).length}</td>
                    <td class="total">{active(tickets).length}</td>
                  </tr>
                </tbody>
              </table>
            </CardContent>
          </Card>

          <Card title="Solved this week per agent" description="Tickets marked solved since Monday, by assignee." level={2}>
            <CardContent>
              <BarChart data={solvedRows(tickets, agents, now.value)}
                        config={SOLVED_CHART}
                        x="name"
                        orientation="horizontal"
                        labels={{ position: "right" }}
                        grid={false}
                        categoryAxis={{ size: 120, tickLine: false, axisLine: false }}
                        valueAxis={false}
                        label="Solved this week per agent"
                        minPointSize={2}
                        class="solved-chart" />
            </CardContent>
          </Card>
        </div>

        <Card title="First reply by priority" description="Median time to the first agent reply against each priority's target." level={2}>
          <Table label="First reply by priority" class="sla">
            <table>
              <thead>
                <tr>
                  <TableHead>Priority</TableHead>
                  <TableHead align="end">Target</TableHead>
                  <TableHead align="end">Median</TableHead>
                  <TableHead align="end">Met target</TableHead>
                  <TableHead align="end">Replied</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={p of PRIORITIES}>
                  <TableCell><span class={["prio", `is-${p}`]}>{p}</span></TableCell>
                  <TableCell align="end">{FIRST_REPLY_HOURS[p]}h</TableCell>
                  <TableCell align="end">{medianLabel(firstReplyTimes([...tickets], now.value, 30, p))}</TableCell>
                  <TableCell align="end">{share(metTargetShare([...tickets], now.value, p))}</TableCell>
                  <TableCell align="end">{firstReplyTimes([...tickets], now.value, 30, p).length}</TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
        </Card>
      </div>
    </Shell>
  </body>
</html>
