import "./style.css";
import { Shell, ShellUser } from "#app/shared/templates/shell";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Alert } from "@elements/ui/alert";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field, FieldLabel } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { initials } from "#app/shared/lib/sla";
import { TeamMember, inviteAgent, revokeInvite } from "./services";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface InviteForm {
  email: string;
  name: string;
  error: string;
  sent: string;
  busy: boolean;
}

function onInvite(form: InviteForm, list: { members: TeamMember[] }) {
  form.busy = true;
  form.error = "";
  form.sent = "";

  try {
    list.members = inviteAgent(form.email, form.name);
    form.sent = form.email;
    form.email = "";
    form.name = "";
  } catch (err: any) {
    form.error = err.message;
  }

  form.busy = false;
}

interface Revoking {
  open: boolean;
  member: TeamMember | null;
}

function onAskRevoke(revoking: Revoking, member: TeamMember) {
  revoking.member = member;
  revoking.open = true;
}

function onRevoke(revoking: Revoking, list: { members: TeamMember[] }) {
  if (revoking.member) {
    list.members = revokeInvite(revoking.member.id);
  }
}

<html lang="en" class="page-team" (
  me: ShellUser,
  members: TeamMember[],
  private list: { members: TeamMember[] } = { members },
  private revoking: Revoking = { open: false, member: null },
  private form: InviteForm = {
    email: "",
    name: "",
    error: "",
    sent: "",
    busy: false,
  },
)>
  <head>
    <title>Team · replyhaven</title>
    <meta name="description" content="Invite and manage agents.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Shell me={me} active="team">
      <div class="team stack is-lg">
        <div class="team-head stack is-xs">
          <h1>Team</h1>
          <p>Invite agents by email. They pick their name and password from the link.</p>
        </div>

        <Card>
          <CardContent>
            <form class="stack" onsubmit={() => onInvite(form, list)}>
              <div class="invite-form">
                <Field label="Email" reserveError={false}>
                  <Input type="email" value={form.email} placeholder="new.agent@replyhaven.dev" required attrs={{ autocapitalize: "none", spellcheck: "false" }} />
                </Field>
                <Field reserveError={false}>
                  <FieldLabel>Name <span class="hint">(optional)</span></FieldLabel>
                  <Input value={form.name} placeholder="Jordan Blake" />
                </Field>
                <Button type="submit" variant="primary" loading={form.busy}>Send invite</Button>
              </div>
              <Alert e:if={form.error} variant="danger" description={form.error} />
              <Alert e:if={form.sent} variant="success" role="status" description={`Invite sent to ${form.sent}.`} />
            </form>
          </CardContent>
        </Card>

        <Card>
          <Table label="Team members" class="team-table">
            <table>
              <thead>
                <tr>
                  <TableHead>Person</TableHead>
                  <TableHead>Role</TableHead>
                  <TableHead>Status</TableHead>
                  <TableHead align="end">Open tickets</TableHead>
                  <TableHead><span class="sr-only">Actions</span></TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={m of list.members}>
                  <TableCell>
                    <div class="team-person">
                      <Avatar alt={m.name || m.email} fallback={initials(m.name || m.email)} />
                      <div>
                        {m.name || "Invited agent"}
                        <small>{m.email}</small>
                      </div>
                    </div>
                  </TableCell>
                  <TableCell><Badge variant={m.role === "admin" ? "accent" : "neutral"}>{m.role}</Badge></TableCell>
                  <TableCell>
                    <Badge e:if={m.active} variant="success" dot>Active</Badge>
                    <Badge e:else variant="warning" dot>Invited</Badge>
                  </TableCell>
                  <TableCell align="end">{m.openTickets}</TableCell>
                  <TableCell align="end">
                    <Button e:if={!m.active} size="sm" onclick={() => onAskRevoke(revoking, m)}>Revoke</Button>
                  </TableCell>
                </tr>
              </tbody>
            </table>
          </Table>
        </Card>

        <AlertDialog open={revoking.open} title={`Revoke the invite for ${revoking.member?.email ?? ""}?`} size="sm">
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction variant="danger" onclick={() => onRevoke(revoking, list)}>Revoke</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialog>
      </div>
    </Shell>
  </body>
</html>
