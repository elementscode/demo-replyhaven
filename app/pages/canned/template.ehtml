import "./style.css";
import { LiveView } from "@elements/app";
import { Shell, ShellUser } from "#app/shared/templates/shell";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent, CardFooter } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Textarea } from "@elements/ui/textarea";
import { CannedReply } from "#app/shared/services/canned";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface Editor {
  id: string;
  title: string;
  body: string;
  error: string;
}

function blank(): Editor {
  return { id: "", title: "", body: "", error: "" };
}

function onSave(replies: LiveView<CannedReply>, editor: Editor) {
  if (!editor.title.trim() || !editor.body.trim()) {
    editor.error = "Give the reply a title and a body.";
    return;
  }

  let fields = { title: editor.title.trim(), body: editor.body.trim() };

  try {
    if (editor.id) {
      let existing = replies.get(editor.id)!;
      replies.update({ ...existing, ...fields }, () => Object.assign(editor, blank()));
    } else {
      replies.insert({ ...fields, createdAt: new Date() }, () => Object.assign(editor, blank()));
    }
  } catch (err: any) {
    editor.error = err.message;
  }
}

function onEdit(editor: Editor, reply: CannedReply) {
  Object.assign(editor, { id: reply.id, title: reply.title, body: reply.body, error: "" });
  scrollTo({ top: 0, behavior: "smooth" });
}

interface Deleting {
  open: boolean;
  reply: CannedReply | null;
}

function onAskDelete(deleting: Deleting, reply: CannedReply) {
  deleting.reply = reply;
  deleting.open = true;
}

function onDelete(replies: LiveView<CannedReply>, deleting: Deleting) {
  if (deleting.reply) {
    replies.delete(deleting.reply);
  }
}

<html lang="en" class="page-canned" (
  me: ShellUser,
  replies: LiveView<CannedReply>,
  private editor: Editor = blank(),
  private deleting: Deleting = { open: false, reply: null },
)>
  <head>
    <title>Canned replies · replyhaven</title>
    <meta name="description" content="Saved replies agents insert into tickets.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Shell me={me} active="canned">
      <div class="canned stack is-lg">
        <div class="canned-head stack is-xs">
          <h1>Canned replies</h1>
          <p e:if={me.role === "admin"}>Saved answers agents insert from the reply box. <code>{"{{first_name}}"}</code> becomes the customer's first name and <code>{"{{agent}}"}</code> the agent's.</p>
          <p e:else>Insert these from the reply box on any ticket. The admin manages this list.</p>
        </div>

        <Card e:if={me.role === "admin"} title={editor.id ? "Edit reply" : "New canned reply"} level={2}>
          <CardContent>
            <form id="canned-form" class="stack" onsubmit={() => onSave(replies, editor)}>
              <Alert e:if={editor.error} variant="danger" description={editor.error} />
              <Field label="Title" reserveError={false}>
                <Input value={editor.title} placeholder="Refund issued" />
              </Field>
              <Field label="Reply" reserveError={false}>
                <Textarea value={editor.body} rows={6} placeholder={"Hi {{first_name}},\n\n…"} />
              </Field>
            </form>
          </CardContent>
          <CardFooter>
            <Button e:if={editor.id} variant="ghost" onclick={() => Object.assign(editor, blank())}>Cancel</Button>
            <Button type="submit" variant="primary" attrs={{ form: "canned-form" }}>{editor.id ? "Save changes" : "Add reply"}</Button>
          </CardFooter>
        </Card>

        <ul class="canned-list stack">
          <li e:for={r of replies.sort((a, b) => a.title.localeCompare(b.title))}>
            <Card title={r.title} level={2} class="canned-item">
              <CardAction slot="action" e:if={me.role === "admin"}>
                <div class="cluster is-xs">
                  <Button variant="ghost" size="sm" onclick={() => onEdit(editor, r)}>Edit</Button>
                  <Button size="sm" onclick={() => onAskDelete(deleting, r)}>Delete</Button>
                </div>
              </CardAction>
              <CardContent>
                <p class="canned-body">{r.body}</p>
              </CardContent>
            </Card>
          </li>
        </ul>

        <AlertDialog open={deleting.open} title={`Delete "${deleting.reply?.title ?? ""}"?`} size="sm">
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction variant="danger" onclick={() => onDelete(replies, deleting)}>Delete</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialog>
      </div>
    </Shell>
  </body>
</html>
