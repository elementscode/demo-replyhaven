import "./style.css";
import { redirect } from "@elements/app";
import { signin } from "#app/shared/services/auth";
import { initials } from "#app/shared/lib/sla";
import { Brand } from "#app/shared/templates/brand";
import { Alert } from "@elements/ui/alert";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import favicon from "#app/shared/assets/favicons/favicon.svg";

export interface DemoLogin {
  name: string;
  email: string;
  role: "admin" | "agent";
}

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function useDemo(form: SigninForm, login: DemoLogin, password: string) {
  form.email = login.email;
  form.password = password;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  demoLogins: DemoLogin[],
  demoPassword: string,
  private form: SigninForm = {
    email: "",
    password: "",
    error: "",
    busy: false,
  },
)>
  <head>
    <title>Sign in · replyhaven</title>
    <meta name="description" content="Sign in to the replyhaven help desk.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="signin-main">
      <div class="signin-panel">
        <Card>
          <CardContent>
            <form class="stack is-lg" onsubmit={() => onSubmit(form)}>
              <div class="stack is-sm signin-head">
                <Brand />
                <h1>Sign in to the help desk</h1>
                <p>For the support team. Customers write in through the contact form.</p>
              </div>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email" reserveError={false}>
                <Input type="email"
                       name="email"
                       value={form.email}
                       placeholder="you@replyhaven.dev"
                       required
                       attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" reserveError={false}>
                <Input type="password"
                       name="password"
                       value={form.password}
                       required
                       attrs={{ autocomplete: "current-password" }} />
              </Field>

              <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>

              <p class="signin-foot">Need help as a customer? <a href="/contact">Contact support</a></p>
            </form>
          </CardContent>
        </Card>

        <Card e:if={demoLogins.length > 0} title="Seeded logins" level={2}>
          <CardContent class="stack">
            <p class="hint">Every account uses the password <code>{demoPassword}</code>. Pick one to sign in.</p>
            <ul class="demo-logins stack is-sm">
              <li e:for={login of demoLogins}>
                <button type="button" class="demo-login" disabled={form.busy} onclick={() => useDemo(form, login, demoPassword)}>
                  <Avatar alt={login.name} fallback={initials(login.name)} />
                  <span class="demo-login-text">
                    <span>{login.name}</span>
                    <small>{login.email}</small>
                  </span>
                  <Badge variant={login.role === "admin" ? "accent" : "neutral"}>{login.role}</Badge>
                </button>
              </li>
            </ul>
          </CardContent>
        </Card>
      </div>
    </main>
  </body>
</html>
