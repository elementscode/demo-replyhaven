import "./style.css";
import { LiveView, type Listener } from "@elements/app";
import { Shell, ShellUser } from "#app/shared/templates/shell";
import { CannedReply } from "#app/shared/services/canned";
import { Agent, Message, Ticket, TypingPing, Viewer, notifyTyping, viewersOf } from "#app/shared/services/tickets";
import { PRIORITIES, STATUSES, ago, dueLabel, duration, fillCanned, firstReplyDueAt, initials, isOverdue } from "#app/shared/lib/sla";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface Draft {
  mode: "reply" | "note";
  body: string;
  error: string;
  tag: string;
}

interface Typer {
  userId: string;
  userName: string;
  mode: "reply" | "note";
  at: number;
}

let lastTypingAt = 0;

function current(view: LiveView<Ticket>): Ticket {
  return view.at(0)!;
}

function conversation(messages: LiveView<Message>): Message[] {
  return messages.sort((a, b) => +a.createdAt - +b.createdAt);
}

function onSend(messages: LiveView<Message>, ticketId: string, me: ShellUser, draft: Draft) {
  if (!draft.body.trim()) {
    draft.error = draft.mode === "reply" ? "Write a reply first." : "Write a note first.";
    return;
  }

  draft.error = "";

  try {
    messages.insert({
      ticketId,
      kind: draft.mode,
      authorId: me.id,
      authorName: me.name,
      body: draft.body.trim(),
      createdAt: new Date(),
    }, () => draft.body = "");
  } catch (err: any) {
    draft.error = err.message;
  }
}

function onType(ticketId: string, draft: Draft) {
  let now = Date.now();
  if (now - lastTypingAt < 1500) {
    return;
  }

  lastTypingAt = now;
  notifyTyping(ticketId, draft.mode);
}

function onTypingPing(ping: TypingPing, typers: Typer[]) {
  let at = Date.now();
  let existing = typers.find((t) => t.userId === ping.userId);

  if (existing) {
    existing.at = at;
    existing.mode = ping.mode;
  } else {
    typers.push({ userId: ping.userId, userName: ping.userName, mode: ping.mode, at });
  }

  setTimeout(() => {
    let i = typers.findIndex((t) => t.userId === ping.userId && t.at === at);
    if (i !== -1) {
      typers.splice(i, 1);
    }
  }, 3500);
}

function typingLine(typers: Typer[]): string {
  if (typers.length === 0) {
    return "";
  }

  let names = typers.map((t) => t.userName.split(" ")[0]);
  let what = typers.every((t) => t.mode === "note") ? "an internal note" : "a reply";

  return names.length === 1
    ? `${names[0]} is writing ${what}…`
    : `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]} are writing…`;
}

function othersViewing(viewers: Viewer[], meId: string): Viewer[] {
  return viewers.filter((v) => v.userId !== meId);
}

function viewingLine(viewers: Viewer[]): string {
  let names = viewers.map((v) => v.userName.split(" ")[0]);

  return names.length === 1
    ? `${names[0]} is also viewing this ticket`
    : `${names.slice(0, -1).join(", ")} and ${names[names.length - 1]} are also viewing`;
}

function onCannedPick(event: Event, canned: LiveView<CannedReply>, ticket: Ticket, me: ShellUser, draft: Draft) {
  let select = event.target as HTMLSelectElement;
  let reply = canned.find((c) => c.id === select.value);
  select.value = "";

  if (!reply) {
    return;
  }

  let text = fillCanned(reply.body, ticket.customerName, me.name);
  draft.body = draft.body.trim() ? `${draft.body.trimEnd()}\n\n${text}` : text;
  draft.mode = "reply";
}

function onFieldChange(view: LiveView<Ticket>, field: "status" | "priority" | "assigneeId", event: Event) {
  let value = (event.target as HTMLSelectElement).value;
  let t = current(view);

  view.update({ ...t, [field]: field === "assigneeId" ? (value || null) : value });
}

function onAddTag(view: LiveView<Ticket>, draft: Draft) {
  let tag = draft.tag.trim().toLowerCase().replace(/\s+/g, "-");
  let t = current(view);
  draft.tag = "";

  if (!tag || t.tags.includes(tag)) {
    return;
  }

  view.update({ ...t, tags: [...t.tags, tag] });
}

function onRemoveTag(view: LiveView<Ticket>, tag: string) {
  let t = current(view);

  view.update({ ...t, tags: t.tags.filter((x) => x !== tag) });
}

function statusIntent(status: string): string {
  switch (status) {
    case "new":
      return "is-info";

    case "open":
      return "is-accent";

    case "pending":
      return "is-warning";

    default:
      return "is-success";
  }
}

function kindLabel(m: Message): string {
  switch (m.kind) {
    case "reply":
      return "replied";

    case "note":
      return "internal note";

    default:
      return "customer";
  }
}

<html lang="en" class="page-ticket" (
  me: ShellUser,
  ticketId: string,
  ticket: LiveView<Ticket>,
  messages: LiveView<Message>,
  canned: LiveView<CannedReply>,
  agents: Agent[],
  presence: Listener<{ ticketId: string }>,
  viewers: Viewer[],
  typing: Listener<TypingPing>,
  private watching: { list: Viewer[] } = { list: viewers },
  private typers: Typer[] = [],
  private now: { value: Date } = { value: new Date() },
  private draft: Draft = {
    mode: "reply",
    body: "",
    error: "",
    tag: "",
  },
) oninit={() => {
  presence.on("notify", () => watching.list = viewersOf(ticketId));
  typing.on("notify", (p) => onTypingPing(p, typers));
  setInterval(() => now.value = new Date(), 30_000);
}}>
  <head>
    <title>#{current(ticket).number} {current(ticket).subject} · replyhaven</title>
    <meta name="description" content="A support ticket.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Shell me={me} active="queue">
      <main class="ticket-page stack is-lg">
        <div class="stack is-sm">
          <a class="ticket-back" href="/">← Back to queue</a>
          <h1 class="ticket-title"><span class="ticket-number">#{current(ticket).number}</span>{current(ticket).subject}</h1>
          <div class="cluster is-sm">
            <span class={["pill", statusIntent(current(ticket).status)]}>{current(ticket).status}</span>
            <span class={["prio", `is-${current(ticket).priority}`]}>{current(ticket).priority}</span>
            <span e:if={isOverdue(current(ticket), now.value)} class="pill is-danger">
              <span class="pill-dot"></span>
              Overdue {duration(+now.value - +firstReplyDueAt(current(ticket)))}
            </span>
            <span e:elseif={dueLabel(current(ticket), now.value)} class="pill">First reply {dueLabel(current(ticket), now.value)}</span>
          </div>
          <div class="ticket-presence row is-start gap-2" aria-live="polite">
            <span e:if={othersViewing(watching.list, me.id).length > 0} class="viewers">
              <span e:for={v of othersViewing(watching.list, me.id)} class="avatar is-sm" title={v.userName}>{initials(v.userName)}</span>
            </span>
            <span e:if={othersViewing(watching.list, me.id).length > 0}>{viewingLine(othersViewing(watching.list, me.id))}</span>
          </div>
        </div>

        <div class="ticket-layout">
          <div class="stack is-md">
            <ol class="conversation stack is-md" aria-label="Conversation">
              <li e:for={m of conversation(messages)} class={["msg", `is-${m.kind}`]}>
                <div class="msg-head">
                  <span e:if={m.kind === "customer"} class="avatar is-sm is-empty">{initials(m.authorName)}</span>
                  <span e:else class="avatar is-sm">{initials(m.authorName)}</span>
                  <span class="msg-author">{m.authorName}</span>
                  <span class="msg-kind">{kindLabel(m)}</span>
                  <time class="msg-time" datetime={m.createdAt.toISOString()} title={m.createdAt.toLocaleString()}>{ago(m.createdAt, now.value)}</time>
                </div>
                <p class="msg-body">{m.body}</p>
              </li>
            </ol>

            <p class="typing" aria-live="polite">{typingLine(typers)}</p>

            <form class={["composer", draft.mode === "note" && "is-note"]} onsubmit={() => onSend(messages, ticketId, me, draft)}>
              <div class="tabs">
                <div class="tab-list" role="tablist">
                  <button type="button" role="tab" class={["tab", draft.mode === "reply" && "is-active"]} onclick={() => draft.mode = "reply"}>Reply to customer</button>
                  <button type="button" role="tab" class={["tab", draft.mode === "note" && "is-active"]} onclick={() => draft.mode = "note"}>Internal note</button>
                </div>
              </div>

              <div class="composer-body stack">
                <textarea value={draft.body}
                          aria-label={draft.mode === "reply" ? "Reply" : "Internal note"}
                          placeholder={draft.mode === "reply" ? `Write to ${current(ticket).customerName}…` : "Only agents see notes…"}
                          oninput={() => onType(ticketId, draft)}></textarea>

                <p e:if={draft.error} class="error" role="alert">{draft.error}</p>

                <div class="composer-foot">
                  <select aria-label="Insert a canned reply" onchange={(e) => onCannedPick(e, canned, current(ticket), me, draft)}>
                    <option value="">Insert canned reply…</option>
                    <option e:for={c of canned.sort((a, b) => a.title.localeCompare(b.title))} value={c.id}>{c.title}</option>
                  </select>
                  <p e:if={draft.mode === "reply"} class="hint">Emails {current(ticket).customerEmail}</p>
                  <p e:else class="hint">Visible to agents only</p>
                  <button type="submit" class="is-primary">{draft.mode === "reply" ? "Send reply" : "Add note"}</button>
                </div>
              </div>
            </form>
          </div>

          <aside class="side stack is-md">
            <div class="card">
              <div class="card-body">
                <div class="field">
                  <label for="status">Status</label>
                  <select id="status" value={current(ticket).status} onchange={(e) => onFieldChange(ticket, "status", e)}>
                    <option e:for={s of STATUSES} value={s}>{s[0].toUpperCase() + s.slice(1)}</option>
                  </select>
                </div>

                <div class="field">
                  <label for="priority">Priority</label>
                  <select id="priority" value={current(ticket).priority} onchange={(e) => onFieldChange(ticket, "priority", e)}>
                    <option e:for={p of PRIORITIES} value={p}>{p[0].toUpperCase() + p.slice(1)}</option>
                  </select>
                </div>

                <div class="field">
                  <label for="assignee">Assignee</label>
                  <select id="assignee" value={current(ticket).assigneeId ?? ""} onchange={(e) => onFieldChange(ticket, "assigneeId", e)}>
                    <option value="">Unassigned</option>
                    <option e:for={a of agents} value={a.id}>{a.id === me.id ? `${a.name} (me)` : a.name}</option>
                  </select>
                </div>

                <div class="field">
                  <label for="tag">Tags</label>
                  <div class="tags-edit">
                    <span e:for={tag of current(ticket).tags} class="tag-chip">
                      {tag}
                      <button type="button" aria-label={`Remove tag ${tag}`} onclick={() => onRemoveTag(ticket, tag)}>×</button>
                    </span>
                  </div>
                  <form class="row gap-2" onsubmit={() => onAddTag(ticket, draft)}>
                    <input id="tag" class="is-sm" value={draft.tag} placeholder="Add a tag">
                    <button type="submit" class="is-sm">Add</button>
                  </form>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card-body">
                <h2>Customer</h2>
                <dl class="facts">
                  <dt>Name</dt>
                  <dd>{current(ticket).customerName}</dd>
                  <dt>Email</dt>
                  <dd><a href={`mailto:${current(ticket).customerEmail}`}>{current(ticket).customerEmail}</a></dd>
                </dl>

                <h2>Timeline</h2>
                <dl class="facts">
                  <dt>Opened</dt>
                  <dd>{ago(current(ticket).createdAt, now.value)}</dd>
                  <dt>First reply</dt>
                  <dd e:if={current(ticket).firstRepliedAt}>after {duration(+current(ticket).firstRepliedAt! - +current(ticket).createdAt)}</dd>
                  <dd e:else>not yet</dd>
                  <dt>Target</dt>
                  <dd>{duration(+firstReplyDueAt(current(ticket)) - +current(ticket).createdAt)}</dd>
                </dl>
              </div>
            </div>
          </aside>
        </div>
      </main>
    </Shell>
  </body>
</html>
