import "./style.css";

<Brand (href: string = "/")>
  <a class="brand" href={href}>
    <svg class="brand-mark" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
      <rect width="26" height="26" rx="7" fill="currentColor"/>
      <path d="M7 10.5 13 6l6 4.5V17a1.5 1.5 0 0 1-1.5 1.5H11l-3.2 2.4V18.4A1.5 1.5 0 0 1 7 17z" fill="none" stroke="var(--accent-ink)" stroke-width="1.8" stroke-linejoin="round"/>
    </svg>
    replyhaven
  </a>
</Brand>
